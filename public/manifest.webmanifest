{
	"name": "Black Mail",
	"short_name": "Black Mail",
	"description": "An email client with read receipts built in, see when every message is queued, sent, delivered, and opened.",
	"start_url": "/mail",
	"scope": "/",
	"display": "standalone",
	"background_color": "#00313A",
	"theme_color": "#171717",
	"share_target": {
		"action": "/share-target",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url",
			"files": [
				{
					"name": "images",
					"accept": ["image/*"]
				}
			]
		}
	},
	"protocol_handlers": [
		{
			"protocol": "mailto",
			"url": "/mail/compose?mailto=%s"
		}
	],
	"icons": [
		{
			"src": "/android-chrome-192x192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any maskable"
		},
		{
			"src": "/android-chrome-512x512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any maskable"
		},
		{
			"src": "/apple-touch-icon.png",
			"sizes": "180x180",
			"type": "image/png"
		}
	]
}